class Solution {
    public int longestConsecutive(int[] nums) {
        if(nums.length==0) return 0;
        Set<Integer> set = new HashSet<>();
        int maxCount = 0;
        int currentCount = 1;
        for(int n:nums){
            set.add(n);
        }
        int ans[] = new int[set.size()];
        int index = 0;
        for(int n:set){
            ans[index++] = n;
        }
        Arrays.sort(ans);
        for(int i=0;i<ans.length-1;i++){
            int current = ans[i];
            int next = ans[i+1];
            if(next == current+1){
                currentCount++;
            }
            else{
                maxCount = Math.max(currentCount,maxCount);
                currentCount = 1;
            }
        }
                maxCount = Math.max(currentCount,maxCount);
        return maxCount;
    }
}